{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "scenarioId": {
      "type": "string"
    },
    "passed": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "passed",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "sensitiveFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "match": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "match"
        ],
        "additionalProperties": false
      }
    },
    "omittedScenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "encoding": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "durationSeconds": {
          "type": "number"
        },
        "pixelFormat": {
          "type": "string"
        }
      },
      "required": [
        "codec",
        "width",
        "height",
        "durationSeconds",
        "pixelFormat"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "scenarioId",
    "passed",
    "checks",
    "sensitiveFindings",
    "omittedScenes"
  ],
  "additionalProperties": false
}