{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "evidence": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "evidence": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "runtimeEvidence": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "screenshot": {
                  "type": "string"
                },
                "ariaSnapshot": {
                  "type": "string"
                },
                "observedAt": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "observedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "evidence",
          "runtimeEvidence"
        ],
        "additionalProperties": false
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "demoReady": {
            "default": false,
            "type": "boolean"
          },
          "userConfirmed": {
            "default": false,
            "type": "boolean"
          },
          "sourceEvidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "runtimeEvidence": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "screenshot": {
                  "type": "string"
                },
                "ariaSnapshot": {
                  "type": "string"
                },
                "observedAt": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "observedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "demoReady",
          "userConfirmed",
          "sourceEvidence",
          "runtimeEvidence"
        ],
        "additionalProperties": false
      }
    },
    "journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "demoReady": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "actors",
          "features",
          "demoReady"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "product",
    "roles",
    "routes",
    "features",
    "journeys"
  ],
  "additionalProperties": false
}