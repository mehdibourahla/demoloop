{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "scenarioId": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "rehearse",
        "record"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "consecutivePasses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "startedAt": {
      "type": "string"
    },
    "endedAt": {
      "type": "string"
    },
    "scenarioDigest": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "omitted"
            ]
          },
          "failure": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "consoleErrors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignoredConsoleErrors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "narrationSeconds": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "executedPath": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string"
          },
          "actionIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "sceneId",
          "actionIndex",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "failedRequests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "ignoredRequests": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "scenarioId",
    "mode",
    "passed",
    "consecutivePasses",
    "startedAt",
    "endedAt",
    "scenarioDigest",
    "scenes",
    "consoleErrors",
    "ignoredConsoleErrors",
    "narrationSeconds",
    "executedPath",
    "failedRequests",
    "ignoredRequests",
    "artifacts"
  ],
  "additionalProperties": false
}