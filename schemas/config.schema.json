{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "app": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "startCommand": {
          "type": "string"
        },
        "commandCwd": {
          "type": "string"
        },
        "healthcheck": {
          "type": "string",
          "format": "uri"
        },
        "production": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "url",
        "production"
      ],
      "additionalProperties": false
    },
    "repository": {
      "default": {
        "root": "."
      },
      "type": "object",
      "properties": {
        "root": {
          "default": ".",
          "type": "string"
        }
      },
      "required": [
        "root"
      ],
      "additionalProperties": false
    },
    "output": {
      "default": {
        "directory": "artifacts"
      },
      "type": "object",
      "properties": {
        "directory": {
          "default": "artifacts",
          "type": "string"
        }
      },
      "required": [
        "directory"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "default": {
        "syntheticData": true,
        "allowProduction": false,
        "scanArtifacts": true
      },
      "type": "object",
      "properties": {
        "syntheticData": {
          "default": true,
          "type": "boolean"
        },
        "allowProduction": {
          "default": false,
          "type": "boolean"
        },
        "scanArtifacts": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "syntheticData",
        "allowProduction",
        "scanArtifacts"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "default": {
        "rehearsalPasses": 2,
        "headless": true
      },
      "type": "object",
      "properties": {
        "rehearsalPasses": {
          "default": 2,
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "headless": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "rehearsalPasses",
        "headless"
      ],
      "additionalProperties": false
    },
    "narration": {
      "default": {
        "provider": "none",
        "elevenlabs": {
          "modelId": "eleven_multilingual_v2",
          "outputFormat": "mp3_44100_128",
          "apiKeyEnv": "ELEVENLABS_API_KEY"
        }
      },
      "type": "object",
      "properties": {
        "provider": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "elevenlabs"
          ]
        },
        "elevenlabs": {
          "default": {
            "modelId": "eleven_multilingual_v2",
            "outputFormat": "mp3_44100_128",
            "apiKeyEnv": "ELEVENLABS_API_KEY"
          },
          "type": "object",
          "properties": {
            "voiceId": {
              "type": "string",
              "minLength": 1
            },
            "modelId": {
              "default": "eleven_multilingual_v2",
              "type": "string",
              "minLength": 1
            },
            "outputFormat": {
              "default": "mp3_44100_128",
              "type": "string",
              "minLength": 1
            },
            "apiKeyEnv": {
              "default": "ELEVENLABS_API_KEY",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "modelId",
            "outputFormat",
            "apiKeyEnv"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "provider",
        "elevenlabs"
      ],
      "additionalProperties": false
    },
    "upload": {
      "default": {
        "enabled": false
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    },
    "devices": {
      "default": {
        "desktop": {
          "width": 1440,
          "height": 900,
          "isMobile": false
        },
        "mobile": {
          "width": 390,
          "height": 844,
          "device": "iPhone 13",
          "isMobile": true
        }
      },
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "device": {
            "type": "string"
          },
          "isMobile": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "width",
          "height",
          "isMobile"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "app",
    "repository",
    "output",
    "privacy",
    "runtime",
    "narration",
    "upload",
    "devices"
  ],
  "additionalProperties": false
}